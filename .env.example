# Variables à renseigner dans Coolify (les SERVICE_* sont générées automatiquement).
# Ne jamais commiter ce fichier une fois rempli. Détails : GUIDE.md, section 13.

# ---------------------------------------------------------------- Accès SSH
# Clé(s) publique(s), ligne complète (cat ~/.ssh/id_ed25519.pub). Une clé par ligne.
# Exemple : ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExemple henoc@poste
SSH_PUBLIC_KEY=

# Mot de passe SSH de l'utilisateur deploy (vide = désactivé). Au moins une des deux variables est requise.
# Exemple : générer avec  openssl rand -base64 24
SSH_PASSWORD=

# Jeton du tunnel Cloudflare : la chaîne eyJ... de la commande d'installation (GUIDE.md, étape 2)
# Exemple : eyJhIjoiMTIzNDU2Nzg5MGFiY2RlZiIsInQiOiJhYmNkLWVmZ2gi...
CLOUDFLARE_TUNNEL_TOKEN=

# UID/GID du process PHP d'OpenLiteSpeed (nobody:nogroup)
WEB_UID=65534
WEB_GID=65534

# ---------------------------------------------------------------- Installation (avant 1er déploiement)
DB_NAME=wordpress
WP_LOCALE=fr_FR

# ---------------------------------------------------------------- PHP du site (lsphp)
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_POST_MAX_SIZE=128M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_TIME=300
PHP_MAX_INPUT_VARS=5000
PHP_MAX_FILE_UPLOADS=50
# Exemple : Africa/Abidjan
PHP_DATE_TIMEZONE=UTC
PHP_DISPLAY_ERRORS=Off
PHP_ERROR_REPORTING=E_ALL & ~E_DEPRECATED
PHP_REALPATH_CACHE_SIZE=4096K
PHP_SESSION_GC_MAXLIFETIME=1440
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=256
PHP_OPCACHE_INTERNED_STRINGS_BUFFER=16
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_REVALIDATE_FREQ=2
# Directives libres, une par ligne. Exemple : opcache.jit = tracing
PHP_EXTRA_INI=

# ---------------------------------------------------------------- PHP de WP-CLI
WPCLI_MEMORY_LIMIT=512M

# ---------------------------------------------------------------- Constantes wp-config.php
# Vide = constante non modifiée. true/false/entiers écrits bruts, le reste entre guillemets.
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
# production | staging | development | local
WP_ENVIRONMENT_TYPE=production
DISALLOW_FILE_EDIT=true
DISALLOW_FILE_MODS=
WP_POST_REVISIONS=10
AUTOSAVE_INTERVAL=120
EMPTY_TRASH_DAYS=30
DISABLE_WP_CRON=false
# true | false | minor
WP_AUTO_UPDATE_CORE=minor
FORCE_SSL_ADMIN=true

# ---------------------------------------------------------------- Redis
REDIS_MAXMEMORY=256mb
